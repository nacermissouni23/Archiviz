{
  "name": "@nacermissouni23/archiviz",
  "version": "0.1.2",
  "type": "module",
  "description": "Local-first, deterministic code architecture explorer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nacermissouni23/Archiviz.git"
  },
  "homepage": "https://github.com/nacermissouni23/Archiviz#readme",
  "bugs": {
    "url": "https://github.com/nacermissouni23/Archiviz/issues"
  },
  "keywords": ["architecture", "visualization", "code-graph", "mermaid", "explorer"],
  "bin": {
    "archiviz": "bin/archi.js",
    "archi": "bin/archi.js"
  },
  "files": [
    "bin/",
    "dist/"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build:server": "tsc",
    "build": "npm run build:server && npm --prefix web run build",
    "prepublishOnly": "npm run build",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@fastify/static": "^7.0.4",
    "fastify": "^4.28.1",
    "pyright": "^1.1.403",
    "tree-sitter-wasms": "^0.1.13",
    "typescript": "^5.9.3",
    "web-tree-sitter": "^0.24.7"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2"
  },
  "overrides": {
    "glob": "^11.0.3"
  }
}
